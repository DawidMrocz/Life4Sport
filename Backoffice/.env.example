# Skopiuj do .env i uzupelnij wlasnymi wartosciami
DB_HOST=localhost
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_EXTRA=Trusted_Connection=True;Integrated Security=false;Encrypt=True;TrustServerCertificate=True
# min. 32 znaki (HS256)
JWT_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_MIN_32_CHARS
RABBITMQ_USER=user
RABBITMQ_PASSWORD=CHANGE_ME
